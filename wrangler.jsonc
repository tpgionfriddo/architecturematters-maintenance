{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "architecturematters-maintenance",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Worker handles page requests; static files are served straight from assets.
		"run_worker_first": ["/*", "!/img/*", "!/favicon.png", "!/robots.txt"]
	},
	"vars": {
		// "503" = temporary outage (good for SEO short-term). Switch to "200" if this runs > ~1 week.
		"MAINTENANCE_STATUS": "503"
	},
	"observability": { "enabled": true }

	// Deployed in OUR account on a throwaway zone, with Cloudflare for SaaS enabled.
	// architecturematters.com.au + www are added as SaaS "custom hostnames" and
	// CNAME to am.<throwaway>. The wildcard route catches that traffic.
	// Replace example-throwaway.com with the real throwaway domain, then uncomment:
	// ,"routes": [
	//   { "pattern": "*/*", "zone_name": "example-throwaway.com" }
	// ]
}
