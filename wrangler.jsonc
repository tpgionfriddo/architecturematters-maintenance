{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "architecturematters-maintenance",
	"main": "src/index.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Worker handles page requests; static files are served straight from assets.
		"run_worker_first": ["/*", "!/img/*", "!/favicon.png", "!/robots.txt"]
	},
	"vars": {
		// "503" = temporary outage (good for SEO short-term). Switch to "200" if this runs > ~1 week.
		"MAINTENANCE_STATUS": "503"
	},
	"observability": { "enabled": true }

	// Must be deployed into the Architecture Matters Cloudflare account (the one
	// that owns the zone). If your login can see several accounts, set this:
	// ,"account_id": "<their account id>"

	// Go live: uncomment and `npm run deploy`. Routes take over traffic on the
	// existing *proxied* (orange-cloud) DNS records, so no DNS changes are needed
	// and the old records stay intact for when WordPress is restored.
	// ,"routes": [
	//   { "pattern": "architecturematters.com.au/*", "zone_name": "architecturematters.com.au" },
	//   { "pattern": "www.architecturematters.com.au/*", "zone_name": "architecturematters.com.au" }
	// ]
}
